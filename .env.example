# --- iCloud --------------------------------------------------------------
# Your Apple ID email.
ICLOUD_USERNAME=you@icloud.com
# App-specific password (NOT your Apple ID password):
# account.apple.com -> Sign-In and Security -> App-Specific Passwords -> "+"
ICLOUD_APP_PASSWORD=abcd-efgh-ijkl-mnop
# Your timezone (IANA name). Used for display and for times given without an offset.
DEFAULT_TIMEZONE=America/New_York
# Optional: calendar used when none is specified (name or id).
# DEFAULT_CALENDAR=Home

# --- Server --------------------------------------------------------------
# Public HTTPS URL where this server is reachable (no trailing slash).
PUBLIC_URL=https://your-app.fly.dev
# Password you type once on the login page when connecting claude.ai.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
OWNER_PASSWORD=change-me
# Static bearer token for the REST API / Claude Code / scripts.
API_KEY=change-me-too
# Where OAuth state is stored (mount a persistent volume here).
DATA_DIR=./data
PORT=8000
